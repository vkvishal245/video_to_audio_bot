# ─── Required ─────────────────────────────────────────────────────────────────

# Telegram bot token — get it from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456:ABCDefGhIJKlmNoPQRsTUVwxyZ

# Secret token used to validate incoming Telegram webhook requests.
# Generate any random string, e.g.: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=change_me_to_a_random_secret

# ─── Server ───────────────────────────────────────────────────────────────────

# Port the Express server listens on.
# Render sets this automatically; leave it as 3000 for local dev.
PORT=3000

# ─── YouTube Cookie Auth (required on cloud servers) ──────────────────────────
#
# Cloud hosts like Render are blocked by YouTube without real user cookies.
# Not needed for local development (your home IP is not blocked).
#
# RECOMMENDED: Create a dedicated Google account just for this bot.
# Do NOT use your personal Google account — if YouTube flags it, you
# won't lose access to your real account.
#
# How to export cookies:
#   1. Create a new Google account (e.g. mybot.youtube@gmail.com)
#   2. Log into youtube.com with that account in Chrome
#   3. Install the Chrome extension "Get cookies.txt LOCALLY":
#      https://chrome.google.com/webstore/detail/get-cookiestxt-locally/cclelndahbckbenkjhflpdbgdldlbecc
#   4. Click the extension icon on youtube.com → Export → save as youtube_cookies.txt
#   5. Verify the file starts with:  # Netscape HTTP Cookie File
#   6. Base64-encode it:
#        Linux/Mac:  base64 -w 0 youtube_cookies.txt
#        Windows:    certutil -encode youtube_cookies.txt tmp.b64 && findstr /v /c:- tmp.b64
#   7. Paste the output as the value below
#
# Cookies typically last 2–4 months if you stay logged into that account.
# When the bot replies "YouTube is blocking downloads", re-export and update this value.
# NEVER commit the raw cookies file — it is already blocked by .gitignore.
YOUTUBE_COOKIES_B64=

# ─── Optional ─────────────────────────────────────────────────────────────────

# Absolute path to a yt-dlp executable.
# Defaults to ./bin/yt-dlp (installed by build.sh), then falls back to PATH.
# YT_DLP_PATH=/usr/local/bin/yt-dlp

# Path to a Netscape-format cookies file on disk (alternative to YOUTUBE_COOKIES_B64).
# Useful for local dev if you prefer a file over the base64 env var.
# YT_DLP_COOKIES_FILE=/absolute/path/to/youtube_cookies.txt

# Set to "true" to show a "(local)" indicator in the /start reply.
# BOT_LOCAL_MODE=true
